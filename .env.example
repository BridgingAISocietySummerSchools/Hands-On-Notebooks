# Copy this file to `.env` and fill in your own key. `.env` is gitignored.
#
#     cp .env.example .env
#
# Get a key at https://openrouter.ai/keys — the notebooks work without one,
# they simply skip the optional "real LLM" cells.

OPENROUTER_API_KEY=sk-or-v1-...

# Any model id from https://openrouter.ai/models
# Cheaper alternative for a full classroom: anthropic/claude-haiku-4.5
OPENROUTER_MODEL=anthropic/claude-opus-5
